@model List<AppointmentDTO>
@{
    ViewData["Title"] = "Doctor Queue";
}

<div class="container py-5">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 p-md-5">
            <span class="badge bg-danger bg-gradient mb-3">Queue</span>
            <h2 class="fw-bold mb-2">Live Queue</h2>
            <p> Total Patients : @Model.Count</p>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-light border">No queue found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Token</th>
                        <th>Patient</th>
                        <th>Time</th>
                        <th>Estimated</th>
                        <th>Emergency</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var appointment = Model[i];
                        var estimatedMinutes = i * 5;
                        if (appointment.Status == "Completed") estimatedMinutes = 0;
                        <tr>
                            <td>@appointment.QueueToken</td>
                            <td>@appointment.PatientName</td>
                            <td>@appointment.AppointmentTime.ToString("HH:mm:ss")</td>
                            <td>@estimatedMinutes min</td>
                            <td>@(appointment.IsEmergency ? "Yes" : "No")</td>
                            <td
                                class="@(appointment.Status == "Completed" ? "text-success" : appointment.Status == "Pending" ? "text-warning" : "text-primary")">
                                @appointment.Status
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    @if (!string.Equals(appointment.Status, "Waiting", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="btn btn-sm btn-warning js-status-btn"
                                                data-appointment-id="@appointment.AppointmentId" data-status="Waiting"
                                                data-patient="@appointment.PatientName" data-token="@appointment.QueueToken">
                                            Mark Waiting
                                        </button>
                                    }

                                    @if (!string.Equals(appointment.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="btn btn-sm btn-success ms-1 js-status-btn"
                                                data-appointment-id="@appointment.AppointmentId" data-status="Completed"
                                                data-patient="@appointment.PatientName" data-token="@appointment.QueueToken">
                                            Mark Completed
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="statusConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title">Confirm status update</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Do you want to update the appointment status?</p>
                <div class="small text-muted" id="confirmStatusText"></div>
            </div>
            <div class="modal-footer">
                <form asp-action="UpdateStatus" method="post" id="statusUpdateForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="appointmentId" id="statusAppointmentId" />
                    <input type="hidden" name="status" id="statusValue" />
                </form>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmStatusBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modalEl = document.getElementById('statusConfirmModal');
            const modal = new bootstrap.Modal(modalEl);
            const form = document.getElementById('statusUpdateForm');
            const appointmentIdInput = document.getElementById('statusAppointmentId');
            const statusInput = document.getElementById('statusValue');
            const confirmText = document.getElementById('confirmStatusText');
            const confirmBtn = document.getElementById('confirmStatusBtn');

            document.querySelectorAll('.js-status-btn').forEach(button => {
                button.addEventListener('click', () => {
                    const appointmentId = button.dataset.appointmentId;
                    const status = button.dataset.status;
                    const patient = button.dataset.patient;
                    const token = button.dataset.token;

                    appointmentIdInput.value = appointmentId;
                    statusInput.value = status;
                    confirmText.textContent = `Token ${token} for ${patient} will be marked ${status}.`;
                    modal.show();
                });
            });

            confirmBtn.addEventListener('click', () => {
                form.submit();
            });
        })();
    </script>
}