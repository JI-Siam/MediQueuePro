@model List<AppointmentDTO>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Appointments</h2>
            <p class="text-muted mb-0">View your appointments history here.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Dashboard">Back</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-light border">No appointments found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Confirmed (UTC)</th>
                        <th>Token</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model)
                    {
                        <tr>
                            <td>@appointment.DoctorName</td>
                            <td>@appointment.AppointmentDate</td>
                            <td>@appointment.AppointmentTime.ToString("HH:mm:ss")</td>
                            <td>@(appointment.CreatedAt?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                            <td>@appointment.QueueToken</td>
                            <td class="@(appointment.Status == "Completed" ? "text-success" : "")">@appointment.Status</td>
                            <td>
                                <a class="btn btn-sm btn-outline-danger" asp-action="AppointmentDetails"
                                   asp-route-id="@appointment.AppointmentId">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>