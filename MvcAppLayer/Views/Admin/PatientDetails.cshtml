@model List<AdminPatientAnalyticsDTO>
@{
    ViewData["Title"] = ViewBag.Title ?? "Patient Details";
}

<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                <div>
                    <span class="badge bg-danger bg-gradient mb-2">Patient Analytics</span>
                    <h2 class="fw-bold mb-1">@ViewBag.Title</h2>
                    <p class="text-muted mb-0">@ViewBag.ScopeName</p>
                </div>
                <a class="btn btn-outline-secondary" asp-action="Analytics">Back to analytics</a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Blood Group</th>
                            <th>Bookings</th>
                            <th>Visits</th>
                            <th>Last Appointment</th>
                            <th>Last Doctor</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@patient.FullName</td>
                                <td>@patient.Email</td>
                                <td>@patient.Phone</td>
                                <td>@patient.Age</td>
                                <td>@patient.Gender</td>
                                <td>@patient.BloodGroup</td>
                                <td><span class="badge text-bg-primary">@patient.TotalBookings</span></td>
                                <td><span class="badge text-bg-success">@patient.TotalVisits</span></td>
                                <td>@patient.LastAppointmentDate</td>
                                <td>@patient.LastDoctorName</td>
                                <td>@patient.LastStatus</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>