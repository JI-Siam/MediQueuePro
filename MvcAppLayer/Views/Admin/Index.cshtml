@model AdminAnalyticsDashboardDTO
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="badge bg-danger bg-gradient mb-2">Admin workspace</span>
                    <h1 class="display-6 fw-bold mb-2">Interactive control panel</h1>
                    <p class="text-muted mb-4">Manage doctors and patients, then jump into analytics to inspect
                        bookings, visits, and patient distribution.</p>

                        <div class="d-flex gap-2 flex-wrap">
                            <a class="btn btn-danger" asp-controller="Admin" asp-action="DoctorCreate">Add Doctor</a>
                            <a class="btn btn-outline-danger" asp-controller="Admin" asp-action="Doctors">Doctors</a>
                            <a class="btn btn-outline-danger" asp-controller="Admin" asp-action="Patients">Patients</a>
                            <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Analytics">Analytics</a>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="p-3 rounded-4 bg-light border h-100">
                                    <div class="text-muted small">Doctors</div>
                                    <div class="fs-2 fw-bold">@Model.Summary.TotalDoctors</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-4 bg-light border h-100">
                                    <div class="text-muted small">Patients</div>
                                    <div class="fs-2 fw-bold">@Model.Summary.TotalPatients</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-4 bg-light border h-100">
                                    <div class="text-muted small">Bookings</div>
                                    <div class="fs-2 fw-bold">@Model.Summary.TotalAppointments</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-4 bg-light border h-100">
                                    <div class="text-muted small">Visits Today</div>
                                    <div class="fs-2 fw-bold">@Model.Summary.TodayVisits</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="text-muted small">Top Doctor</div>
                                <h5 class="mb-0">@((Model.Doctors.FirstOrDefault()?.DoctorName) ?? "No data")</h5>
                            </div>
                            <span class="badge text-bg-danger">@((Model.Doctors.FirstOrDefault()?.TotalBookings) ?? 0)
                                bookings</span>
                            </div>
                            <p class="text-muted mb-0">@((Model.Doctors.FirstOrDefault()?.SpecializationName) ?? "-")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <div class="text-muted small">Top Specialization</div>
                                    <h5 class="mb-0">@((Model.Specializations.FirstOrDefault()?.SpecializationName) ?? "No data")</h5>
                                </div>
                                <span class="badge text-bg-primary">@((Model.Specializations.FirstOrDefault()?.TotalBookings) ??
                                                                0)</span>
                                </div>
                                <p class="text-muted mb-0">Doctors: @((Model.Specializations.FirstOrDefault()?.DoctorsCount) ?? 0)
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <div class="text-muted small">Unique Patients</div>
                                        <h5 class="mb-0">@Model.UniquePatients.Count</h5>
                                    </div>
                                    <span class="badge text-bg-success">details ready</span>
                                </div>
                                <a class="btn btn-outline-secondary btn-sm" asp-controller="Admin" asp-action="Analytics">Open full
                                    analytics</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                <div>
                                    <h4 class="mb-1">Recent insights</h4>
                                    <p class="text-muted mb-0">Top rows from doctor, specialization, and patient analytics.</p>
                                </div>
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Admin" asp-action="Analytics">Open
                                    analytics</a>
                                </div>
                                <div class="row g-3">
                                    <div class="col-lg-4">
                                        <div class="border rounded-4 p-3 h-100">
                                            <div class="fw-semibold mb-2">Top doctors</div>
                                            <div class="small text-muted">
                                                @foreach (var doctor in Model.Doctors.Take(3))
                                                {
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <span>@doctor.DoctorName</span>
                                                        <span>@doctor.TotalBookings bookings</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="border rounded-4 p-3 h-100">
                                            <div class="fw-semibold mb-2">Top specializations</div>
                                            <div class="small text-muted">
                                                @foreach (var specialization in Model.Specializations.Take(3))
                                                {
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <span>@specialization.SpecializationName</span>
                                                        <span>@specialization.TotalBookings bookings</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="border rounded-4 p-3 h-100">
                                            <div class="fw-semibold mb-2">Recent unique patients</div>
                                            <div class="small text-muted">
                                                @foreach (var patient in Model.UniquePatients.Take(3))
                                                {
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <span>@patient.FullName</span>
                                                        <span>@patient.TotalBookings bookings</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
